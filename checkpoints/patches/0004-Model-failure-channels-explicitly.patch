diff --git a/test/checkpoint-03/failure-channels.test.ts b/test/checkpoint-03/failure-channels.test.ts
new file mode 100644
index 0000000..7830ca3
--- /dev/null
+++ b/test/checkpoint-03/failure-channels.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { Effect } from "effect";
+import { ConfigError, DnsError, RepositoryError, type DomainError } from "../../src/domain/errors.js";
+import { assertCheckInvariant, exitKind, validatePositiveInterval } from "../../src/domain/defects.js";
+import { policyDecision } from "../../src/domain/classify-match.js";
+import { recoverTransientProbe } from "../../src/services/RecoveryPolicy.js";
+
+describe("failure channels", () => {
+  it("distinguishes typed failure, defect, and interruption", async () => {
+    expect(exitKind(await Effect.runPromise(Effect.exit(validatePositiveInterval(0))))).toBe("typed-failure");
+    expect(exitKind(await Effect.runPromise(Effect.exit(assertCheckInvariant(false))))).toBe("defect");
+    expect(exitKind(await Effect.runPromise(Effect.exit(Effect.interrupt)))).toBe("interruption");
+  });
+  it("handles every policy choice", () => {
+    expect(policyDecision({ _tag: "Ignore" })).toBe("ignored");
+    expect(policyDecision({ _tag: "Escalate" })).toBe("escalated");
+    expect(policyDecision({ _tag: "Accept" })).toBe("accepted");
+  });
+  it("recovers selected transport failures only", async () => {
+    const recovered = recoverTransientProbe(Effect.fail(new DnsError({ host: "example.test" })) as Effect.Effect<string, DomainError>, () => "degraded");
+    await expect(Effect.runPromise(recovered)).resolves.toBe("degraded");
+    const retained = recoverTransientProbe(Effect.fail(new RepositoryError({ operation: "save" })) as Effect.Effect<string, DomainError>, () => "degraded");
+    await expect(Effect.runPromise(retained)).rejects.toBeTruthy();
+    void new ConfigError({ reason: "typed" });
+  });
+});
