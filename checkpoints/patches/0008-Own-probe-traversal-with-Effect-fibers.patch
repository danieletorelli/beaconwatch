diff --git a/test/checkpoint-07/owned-concurrency.test.ts b/test/checkpoint-07/owned-concurrency.test.ts
new file mode 100644
index 0000000..6460b50
--- /dev/null
+++ b/test/checkpoint-07/owned-concurrency.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from "vitest";
+import { Effect, Exit, Fiber, Scope } from "effect";
+import { runOnceEffect, watchLoopEffect } from "../../src/watch/Scheduler.js";
+import { StatusState } from "../../src/watch/StatusState.js";
+import { Target, targetId, type CheckResult } from "../../src/domain/schema.js";
+import { FakeProbeClient } from "../../src/services/ProbeClient.js";
+
+const targets = Array.from({ length: 6 }, (_, i) => new Target({ id: targetId(`target_${i}`), name: `${i}`, url: "https://example.test", method: "GET", expectedStatus: [200], interval: 10, timeout: 50, slowThreshold: 20, enabled: true }));
+const services = (client: FakeProbeClient, applyCheck: (c: CheckResult) => Promise<void>) => ({ client, repository: { applyCheck, getOpenIncident: async () => undefined } as any, status: new StatusState() });
+
+describe("Effect-owned scheduler concurrency", () => {
+  it("uses Effect collection concurrency to bound traversal", async () => {
+    let active = 0, peak = 0;
+    const client = new FakeProbeClient({});
+    client.probe = async () => { active++; peak = Math.max(peak, active); await new Promise((r) => setTimeout(r, 2)); active--; return { status: 200, body: {}, bytes: 1 }; };
+    const applied: string[] = [];
+    await Effect.runPromise(runOnceEffect(targets, { queueCapacity: 2, workerCount: 2 }, services(client, async (c) => { applied.push(c.targetId); })));
+    expect(peak).toBe(2); expect(applied).toHaveLength(6);
+  });
+  it("interrupts and awaits in-flight traversal children", async () => {
+    let finalized = false;
+    const client = new FakeProbeClient({});
+    client.probe = async (_target, signal) => new Promise((_, reject) => signal!.addEventListener("abort", () => { finalized = true; reject(signal!.reason); }, { once: true }));
+    await Effect.runPromise(Effect.gen(function*() {
+      const fiber = yield* Effect.forkChild(runOnceEffect(targets.slice(0, 2), { queueCapacity: 2, workerCount: 2 }, services(client, async () => {})));
+      yield* Effect.sleep("5 millis");
+      yield* Fiber.interrupt(fiber);
+    }));
+    expect(finalized).toBe(true);
+  });
+  it("scope close interrupts the watch fiber and awaits child finalization", async () => {
+    const events: string[] = [];
+    const client = new FakeProbeClient({});
+    client.probe = (_target, signal) => new Promise((_, reject) => signal!.addEventListener("abort", () => {
+      events.push("aborted");
+      events.push("finalized"); reject(signal!.reason);
+    }, { once: true }));
+    await Effect.runPromise(Effect.gen(function*() {
+      const scope = yield* Scope.make();
+      yield* Effect.forkIn(watchLoopEffect(targets.slice(0, 1), { queueCapacity: 1, workerCount: 1 }, services(client, async () => {})), scope);
+      yield* Effect.sleep("5 millis");
+      yield* Scope.close(scope, Exit.void);
+    }));
+    events.push("closed");
+    expect(events).toEqual(["aborted", "finalized", "closed"]);
+  });
+});
