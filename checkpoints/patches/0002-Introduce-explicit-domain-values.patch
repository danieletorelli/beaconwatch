diff --git a/test/checkpoint-01/explicit-values.test.ts b/test/checkpoint-01/explicit-values.test.ts
new file mode 100644
index 0000000..5941872
--- /dev/null
+++ b/test/checkpoint-01/explicit-values.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { Equal, Option, Result } from "effect";
+import { ConfigError } from "../../src/domain/errors.js";
+import { TargetConfig, Up, durationMillis, targetId } from "../../src/domain/schema.js";
+import { classifyProbe, incidentCloseTime, makeCheckResult, renameCheck } from "../../src/domain/values.js";
+
+const target = new TargetConfig({ id: "target_values", name: "Values", url: "https://example.test", method: "GET", expectedStatus: [200], interval: 10, timeout: 20, slowThreshold: 5 });
+
+describe("explicit domain values", () => {
+  it("represents both close-time branches", () => {
+    expect(Option.isNone(incidentCloseTime({}))).toBe(true);
+    expect(Option.isSome(incidentCloseTime({ closedAt: new Date(0) }))).toBe(true);
+  });
+  it("returns expected classification failures without throwing", () => {
+    expect(Result.isFailure(classifyProbe({ target, status: 503, duration: 1 }))).toBe(true);
+    expect(Result.isFailure(classifyProbe({ target, duration: 1, failure: new ConfigError({ reason: "bad config" }) }))).toBe(true);
+  });
+  it("compares value objects and replaces fields immutably", () => {
+    const a = makeCheckResult({ id: "a", targetId: targetId("target_values"), duration: 1, classification: new Up() });
+    const b = makeCheckResult({ id: "a", targetId: targetId("target_values"), duration: 1, classification: new Up() });
+    expect(Equal.equals(a, b)).toBe(true);
+    const renamed = renameCheck(a, "b");
+    expect(a.id).toBe("a");
+    expect(renamed.id).toBe("b");
+  });
+  it("keeps numeric and explicit string durations in milliseconds", () => {
+    expect(durationMillis(250)).toBe(250);
+    expect(durationMillis("2 seconds")).toBe(2000);
+  });
+});
