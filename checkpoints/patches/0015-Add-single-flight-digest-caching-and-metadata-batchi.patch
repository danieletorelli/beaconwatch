@@ -1,44 +1,10 @@
-import type { TargetId } from "../domain/schema.js";
-import type { TargetDigest } from "../services/DigestService.js";
-export class DigestCache {
-  private identityEntries = new Map<object, Promise<TargetDigest>>();
-  private entries = new Map<string, { expires: number; value: Promise<TargetDigest> }>();
-  constructor(
-    private compute: (id: TargetId) => Promise<TargetDigest>,
-    private ttl = 60_000,
-    private capacity = 128,
-  ) {}
-  async getByIdentity(id: TargetId) {
-    const key = { id };
-    const old = this.identityEntries.get(key);
-    if (old) return { ...(await old) };
-    const value = this.compute(id);
-    this.identityEntries.set(key, value);
-    return { ...(await value) };
-  }
-  async get(id: TargetId) {
-    const now = Date.now(),
-      key = `digest:${String(id).toLowerCase()}`,
-      old = this.entries.get(key);
-    if (old && old.expires > now) return { ...(await old.value) };
-    const value = this.compute(id);
-    this.entries.set(key, { expires: now + this.ttl, value });
-    if (this.entries.size > this.capacity)
-      this.entries.delete(this.entries.keys().next().value!);
-    return { ...(await value) };
-  }
-  async getConcurrent(id: TargetId) {
-    const key = `digest:${String(id).toLowerCase()}`, old = this.entries.get(key);
-    if (old) return { ...(await old.value) };
-    const result = await this.compute(id);
-    this.entries.set(key, { expires: Date.now() + this.ttl, value: Promise.resolve(result) });
-    return { ...result };
-  }
-  async invalidate(id: TargetId) {
-    this.entries.delete(String(id).toLowerCase());
-  }
-}
-export const makeLayer = (
-  c: (id: TargetId) => Promise<TargetDigest>,
-  ttl?: number,
-) => new DigestCache(c, ttl);
+import { Cache, Context, Duration, Effect, Exit, Layer } from "effect"
+import type { TargetId } from "../domain/schema.js"
+import type { TargetDigest } from "../services/DigestService.js"
+
+export interface DigestCacheShape { readonly get: (id: TargetId) => Effect.Effect<TargetDigest, Error>; readonly invalidate: (id: TargetId) => Effect.Effect<void> }
+export class DigestCache extends Context.Service<DigestCache, DigestCacheShape>()("beaconwatch/DigestCache") {}
+export const makeLayer = (compute: (id: TargetId) => Effect.Effect<TargetDigest, Error>, ttl: Duration.Input = "1 minute", failureTtl: Duration.Input = "1 second") => Layer.effect(DigestCache)(Effect.gen(function*() {
+  const cache = yield* Cache.makeWith(compute, { capacity: 128, timeToLive: (exit) => Exit.isSuccess(exit) ? ttl : failureTtl })
+  return { get: (id) => Cache.get(cache, id).pipe(Effect.map((digest) => ({ ...digest }))), invalidate: (id) => Cache.invalidate(cache, id) }
+}))
