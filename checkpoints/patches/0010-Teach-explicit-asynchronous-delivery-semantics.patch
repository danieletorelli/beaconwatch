 }
 export class Readiness {
-  ready = false;
-  result?: string;
-  async wait() { while (!this.ready) await new Promise((r) => setTimeout(r, 10)); return this.result; }
-  complete(value: string) { this.result = value; this.ready = true; }
-  fail(_error: unknown) {}
-  reset() { this.ready = false; }
+  private signal = Deferred.makeUnsafe<string, unknown>();
+  private generation = 0;
+  wait(generation = this.generation) {
+    if (generation !== this.generation) return Promise.reject(new Error(`readiness generation ${generation} retired`));
+    return Effect.runPromise(Deferred.await(this.signal));
+  }
+  complete(value: string, generation = this.generation) {
+    return generation === this.generation && Effect.runSync(Deferred.succeed(this.signal, value));
+  }
+  fail(error: unknown, generation = this.generation) {
+    return generation === this.generation && Effect.runSync(Deferred.fail(this.signal, error));
+  }
+  reset() {
+    Effect.runSync(Deferred.fail(this.signal, new Error(`readiness generation ${this.generation} retired`)));
+    this.signal = Deferred.makeUnsafe<string, unknown>();
+    return ++this.generation;
+  }
   async runGeneration(value: string) {
-    if (this.result !== undefined) { this.ready = true; return this.wait(); }
-    this.complete(value);
-    return this.wait();
+    const generation = this.reset();
+    this.complete(value, generation);
+    return this.wait(generation);
   }
diff --git a/test/checkpoint-09/delivery-semantics.test.ts b/test/checkpoint-09/delivery-semantics.test.ts
new file mode 100644
index 0000000..ae26efc
--- /dev/null
+++ b/test/checkpoint-09/delivery-semantics.test.ts
@@ -0,0 +1,47 @@
+import { expect, it } from "vitest"
+import { Effect } from "effect"
+import { BulletinBus, callbackJobAdapter, JobBuffer, WorkerBroadcast } from "../../src/watch/Scheduler.js"
+import { Readiness } from "../../src/watch/StatusState.js"
+
+it("makes overflow, one-shot readiness, broadcast, and work distribution explicit", async () => {
+  const callback: any = callbackJobAdapter(new JobBuffer<number>(1))
+  expect(callback(1)).toBe(true)
+  expect(callback(2)).toBe(false)
+  expect(callback.dropped()).toBe(1)
+
+  const ready = new Readiness()
+  const first = ready.wait()
+  ready.complete("one")
+  expect(await first).toBe("one")
+  ready.reset()
+  const second = ready.wait()
+  ready.fail(new Error("boot failed"))
+  await expect(second).rejects.toThrow("boot failed")
+  await expect(ready.runGeneration("two")).resolves.toBe("two")
+
+  const bus: any = new BulletinBus<number>()
+  const a: number[] = [], b: number[] = []
+  await Effect.runPromise(Effect.scoped(Effect.gen(function*() {
+    yield* Effect.forkScoped(bus.subscribe((value: number) => a.push(value)) as any)
+    yield* Effect.forkScoped(bus.subscribe((value: number) => b.push(value)) as any)
+    yield* Effect.yieldNow
+    yield* (bus.publish(1) as any)
+    while (a.length < 1 || b.length < 1) yield* Effect.yieldNow
+  }) as any))
+  expect([a, b]).toEqual([[1], [1]])
+  expect(bus.subscriberCount()).toBe(0)
+
+  const workers: any = new WorkerBroadcast<number>()
+  const seen: number[] = []
+  let consumed!: () => void
+  const allConsumed = new Promise<void>(resolve => { consumed = resolve })
+  await Effect.runPromise(Effect.scoped(Effect.gen(function*() {
+    const consume = (value: number) => { seen.push(value); if (seen.length === 3) consumed() }
+    yield* Effect.forkScoped(workers.addWorker(consume) as any)
+    yield* Effect.forkScoped(workers.addWorker(consume) as any)
+    yield* Effect.yieldNow
+    yield* Effect.all([workers.offer(1), workers.offer(2), workers.offer(3)] as any)
+    yield* Effect.promise(() => allConsumed)
+  }) as any))
+  expect(seen.sort()).toEqual([1, 2, 3])
+})
