@@ -4,7 +4,7 @@ import { probeOnce } from "../probe/ProbeProgram.js";
 import type { ProbeClientShape } from "../services/ProbeClient.js";
 import type { CheckRepositoryShape } from "../repo/CheckRepository.js";
 import type { StatusState } from "./StatusState.js";
-import { Cause, Effect, Queue } from "effect";
+import { Cause, Effect, PubSub, Queue, Schedule } from "effect";
 export interface SchedulerOptions {
   queueCapacity: number;
   workerCount: number;
@@ -57,9 +57,20 @@ export function watchLoopEffect(
 ) {
   const active = targets.filter(enabled);
-  const wait = active.length === 0 ? 60_000 : Math.min(...active.map((t) => t.interval));
-  return validateEffect(options).pipe(
-    Effect.andThen(Effect.forever(runOnceEffect(active, options, s).pipe(Effect.andThen(Effect.sleep(wait))))),
-  );
+  return Effect.scoped(Effect.gen(function*() {
+    yield* validateEffect(options);
+    const queue = yield* Queue.make<Target | TargetConfig, Cause.Done>({ capacity: options.queueCapacity });
+    const consume = Effect.forever(Effect.gen(function*() {
+      const target = yield* Queue.take(queue);
+      const check = yield* awaitPromise((signal) => probeOnce(target, s.client, signal));
+      yield* awaitPromise(() => s.repository.applyCheck(check));
+      const incident = yield* awaitPromise(() => s.repository.getOpenIncident(check.targetId));
+      yield* awaitPromise(() => s.status.update(check, incident));
+    }));
+    yield* Effect.all([
+      ...Array.from({ length: options.workerCount }, () => consume),
+      ...active.map((target) => Effect.repeat(Queue.offer(queue, target), Schedule.spaced(target.interval))),
+    ], { concurrency: "unbounded", discard: true });
+  }));
 }
 export function watchLoop(
   targets: readonly (Target | TargetConfig)[], options: SchedulerOptions,
@@ -92,16 +104,38 @@ export class JobBuffer<A> {
   dequeue(): JobDequeue<A> { return { take: () => this.take() }; }
 }
 export const callbackJobAdapter = <A>(buffer: JobBuffer<A>) =>
-  (job: A) => { void buffer.offer(job); };
+  {
+    let dropped = 0;
+    const offer = (job: A) => {
+      const accepted = Queue.offerUnsafe(buffer["queue"], job);
+      if (!accepted) dropped++;
+      return accepted;
+    };
+    offer.dropped = () => dropped;
+    return offer;
+  };

 export class BulletinBus<A> {
-  private subscribers: Array<(value: A) => void> = [];
-  subscribe(f: (value: A) => void) { this.subscribers.push(f); }
-  publish(value: A) { this.subscribers.shift()?.(value); }
+  private readonly pubsub = Effect.runSync(PubSub.unbounded<A>());
+  private active = 0;
+  subscribe(f: (value: A) => void) {
+    const pubsub = this.pubsub;
+    return Effect.acquireRelease(
+      Effect.sync(() => { this.active++; }),
+      () => Effect.sync(() => { this.active--; }),
+    ).pipe(Effect.andThen(Effect.scoped(Effect.gen(function*() {
+      const subscription = yield* PubSub.subscribe(pubsub);
+      yield* Effect.forever(Effect.flatMap(PubSub.take(subscription), (value) => Effect.sync(() => f(value))));
+    }))));
+  }
+  publish(value: A) { return PubSub.publish(this.pubsub, value); }
+  subscriberCount() { return this.active; }
 }

 export class WorkerBroadcast<A> {
-  private workers: Array<(value: A) => void> = [];
-  addWorker(f: (value: A) => void) { this.workers.push(f); }
-  offer(value: A) { for (const worker of this.workers) worker(value); }
+  private readonly queue = Effect.runSync(Queue.unbounded<A>());
+  addWorker(f: (value: A) => void) {
+    return Effect.forever(Effect.flatMap(Queue.take(this.queue), (value) => Effect.sync(() => f(value))));
+  }
+  offer(value: A) { return Queue.offer(this.queue, value); }
 }
