+import { Duration, Effect, Schema } from "effect";
+import { CheckFailure, CheckResult, Down, Incident, InvalidResponse, ResponseMetadata, Slow, Target, Unknown, Up, targetId } from "./schema.js";
+
+const Classification = Schema.Union([
+  Schema.Struct({ _tag: Schema.Literal("Up") }),
+  Schema.Struct({ _tag: Schema.Literal("Slow") }),
+  Schema.Struct({ _tag: Schema.Literal("Down") }),
+  Schema.Struct({ _tag: Schema.Literal("InvalidResponse") }),
+  Schema.Struct({ _tag: Schema.Literal("Unknown") }),
+]);
+export class StoredCheck extends Schema.Class<StoredCheck>("StoredCheck")({
+  id: Schema.String,
+  targetId: Schema.String,
+  checkedAt: Schema.DateFromString,
+  durationMillis: Schema.Number.check(Schema.isGreaterThan(0)),
+  classification: Classification,
+  failure: Schema.optionalKey(Schema.Struct({ reason: Schema.String })),
+  response: Schema.optionalKey(Schema.Struct({
+    status: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 100, maximum: 599 }))),
+    bytes: Schema.optionalKey(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
+  })),
+}) {}
+const PersistedStoredCheck = Schema.Struct({
+  id: Schema.String,
+  targetId: Schema.String,
+  checkedAt: Schema.DateFromString,
+  durationMillis: Schema.Union([Schema.Number.check(Schema.isGreaterThan(0)), Schema.String]),
+  classification: Classification,
+  failure: Schema.optionalKey(Schema.Struct({ reason: Schema.String })),
+  response: Schema.optionalKey(Schema.Struct({
+    status: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 100, maximum: 599 }))),
+    bytes: Schema.optionalKey(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
+  })),
+});
+const LegacyStoredCheck = Schema.Struct({
+  id: Schema.String,
+  targetId: Schema.String,
+  checkedAt: Schema.DateFromString,
+  duration: Schema.Number.check(Schema.isGreaterThan(0)),
+  classification: Classification,
+  failure: Schema.optionalKey(Schema.Struct({ reason: Schema.String })),
+  response: Schema.optionalKey(Schema.Struct({
+    status: Schema.optionalKey(Schema.Int.check(Schema.isBetween({ minimum: 100, maximum: 599 }))),
+    bytes: Schema.optionalKey(Schema.Int.check(Schema.isGreaterThanOrEqualTo(0))),
+  })),
+});
+
+const classes = { Up, Slow, Down, InvalidResponse, Unknown };
+const decodeDuration = (value: number | string) => {
+  if (typeof value === "number") return Duration.millis(value);
+  if (value === "Infinity" || value === "infinity") return Duration.infinity;
+  if (value.startsWith("millis:")) return Duration.millis(Number(value.slice(7)));
+  if (value.startsWith("nanos:")) return Duration.nanos(BigInt(value.slice(6)));
+  throw new TypeError(`unknown duration encoding: ${value}`);
+};
+const encodeDuration = Duration.match({
+  onMillis: (millis) => `millis:${millis}`,
+  onNanos: (nanos) => `nanos:${nanos}`,
+  onInfinity: () => "infinity",
+  onNegativeInfinity: () => "negative-infinity",
+});
+const encodeDurationInput = Duration.match({
+  onMillis: (millis) => `${BigInt(millis)} millis`,
+  onNanos: (nanos) => `${nanos} nanos`,
+  onInfinity: () => "Infinity",
+  onNegativeInfinity: () => "-Infinity",
+});
+export const decodeStoredCheck = (input: unknown) => Schema.decodeUnknownEffect(Schema.Union([PersistedStoredCheck, LegacyStoredCheck]))(input).pipe(
+  Effect.map((row) => new CheckResult({
+    id: row.id,
+    targetId: targetId(row.targetId),
+    checkedAt: row.checkedAt,
+    duration: decodeDuration("durationMillis" in row ? row.durationMillis : row.duration),
+    classification: new classes[row.classification._tag](),
+    ...(row.failure === undefined ? {} : { failure: new CheckFailure(row.failure) }),
+    response: new ResponseMetadata(row.response ?? {}),
+  })),
+);
+export const decodeCanonicalStoredCheck = (input: unknown) =>
+  Schema.decodeUnknownEffect(StoredCheck)(input).pipe(
+    Effect.flatMap((row) => Schema.encodeEffect(StoredCheck)(row)),
+    Effect.flatMap(decodeStoredCheck),
+  );
+export const decodeStoredCheckSync = (input: unknown) => Effect.runSync(decodeStoredCheck(input));
+export const encodeStoredCheck = (check: CheckResult) => ({
+  id: check.id,
+  targetId: check.targetId,
+  checkedAt: check.checkedAt.toISOString(),
+  durationMillis: encodeDuration(check.duration),
+  classification: { _tag: check.classification._tag },
+  ...(check.failure === undefined ? {} : { failure: { reason: check.failure.reason } }),
+  response: { ...check.response },
+});
+const StoredIncident = Schema.Struct({
+  id: Schema.String,
+  targetId: Schema.String,
+  openedAt: Schema.DateFromString,
+  closedAt: Schema.optionalKey(Schema.DateFromString),
+  status: Schema.Literals(["Open", "Closed"]),
+  reason: Schema.String,
+  latestCheckId: Schema.String,
+  summary: Schema.optionalKey(Schema.String),
+});
+export const decodeStoredTargetSync = (input: unknown) =>
+  Schema.decodeUnknownSync(Target)(input);
+export const encodeStoredTarget = (target: Target) => ({
+  ...target,
+  interval: encodeDurationInput(target.interval),
+  timeout: encodeDurationInput(target.timeout),
+  slowThreshold: encodeDurationInput(target.slowThreshold),
+});
+export const decodeStoredIncidentSync = (input: unknown) => {
+  const row = Schema.decodeUnknownSync(StoredIncident)(input);
+  return new Incident({
+    id: row.id, targetId: targetId(row.targetId), openedAt: row.openedAt, status: row.status,
+    reason: row.reason, latestCheckId: row.latestCheckId,
+    ...(row.closedAt === undefined ? {} : { closedAt: row.closedAt }),
+    ...(row.summary === undefined ? {} : { summary: row.summary }),
+  });
+};
+export const storedCheckJsonSchema = Schema.toJsonSchemaDocument(StoredCheck);
