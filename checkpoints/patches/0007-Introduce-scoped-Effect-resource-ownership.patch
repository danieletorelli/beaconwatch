diff --git a/test/checkpoint-06/resource-safety.test.ts b/test/checkpoint-06/resource-safety.test.ts
new file mode 100644
index 0000000..1abb693
--- /dev/null
+++ b/test/checkpoint-06/resource-safety.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import { Effect, Fiber } from "effect";
+import { ConnectionPool } from "../../src/repo/ConnectionPool.js";
+import { RequestRuntimeHost, ManagedAppRuntime } from "../../src/runtime/ManagedRuntime.js";
+import { TelemetryExporter, useTelemetryExporter, useTelemetryExporterEffect } from "../../src/obs/Telemetry.js";
+
+describe("Effect-owned resources", () => {
+  it("shares one scoped graph without wiring framework shutdown yet", async () => {
+    const before = ManagedAppRuntime.acquired;
+    const host = new RequestRuntimeHost();
+    await host.handle(async () => 1); await host.handle(async () => 2); await host.shutdown();
+    expect(ManagedAppRuntime.acquired).toBe(before);
+  });
+  it("runs acquireRelease finalizers when an Effect fiber is interrupted", async () => {
+    const events: string[] = [];
+    const pool = new ConnectionPool(1, { onAcquire: () => { events.push("acquire"); }, onRelease: () => { events.push("release"); } });
+    await Effect.runPromise(Effect.gen(function*() {
+      const fiber = yield* Effect.forkChild(pool.withConnectionEffect(() => Effect.never));
+      yield* Effect.yieldNow;
+      yield* Fiber.interrupt(fiber);
+    }));
+    expect(events).toEqual(["acquire", "release"]);
+  });
+  it("bounds an acquireRelease exporter finalizer", async () => {
+    const exporter = new TelemetryExporter();
+    const started = Date.now();
+    await expect(useTelemetryExporter(exporter, async () => { throw new Error("use"); }, 5)).rejects.toThrow("use");
+    expect(exporter.events).toEqual(["start"]);
+    expect(Date.now() - started).toBeLessThan(100);
+  });
+  it("shuts an exporter down on success, failure, and interruption", async () => {
+    class Exporter extends TelemetryExporter { override async shutdown() { this.events.push("shutdown"); } }
+    for (const use of [Effect.void, Effect.fail("failure")]) {
+      const exporter = new Exporter();
+      await Effect.runPromise(Effect.exit(useTelemetryExporterEffect(exporter, use)));
+      expect(exporter.events).toEqual(["start", "shutdown"]);
+    }
+    const exporter = new Exporter();
+    await Effect.runPromise(Effect.gen(function*() {
+      const fiber = yield* Effect.forkChild(useTelemetryExporterEffect(exporter, Effect.never));
+      yield* Effect.yieldNow;
+      yield* Fiber.interrupt(fiber);
+    }));
+    expect(exporter.events).toEqual(["start", "shutdown"]);
+  });
+});
