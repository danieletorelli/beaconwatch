diff --git a/src/domain/history-wire.ts b/src/domain/history-wire.ts
new file mode 100644
index 0000000..e89aaed
--- /dev/null
+++ b/src/domain/history-wire.ts
@@ -0,0 +1,43 @@
+import { Duration, Effect, Schema } from "effect";
+import { decodeCanonicalStoredCheck } from "./storage.js";
+import { CheckResult } from "./schema.js";
+
+const DurationMillis = Schema.Finite.check(
+  Schema.makeFilter((millis) =>
+    millis > 0 && Number.isSafeInteger(millis * 1_000_000)
+      ? undefined
+      : "duration must be positive and exactly representable as a safe integer number of nanoseconds",
+  ),
+);
+
+const rfc3339Instant = /^(\d{4})-(\d{2})-(\d{2})T([01]\d|2[0-3]):([0-5]\d):([0-5]\d)(?:\.\d{1,3})?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$/;
+const Rfc3339Instant = Schema.String.check(Schema.makeFilter((text) => {
+  const match = rfc3339Instant.exec(text);
+  if (!match) return "expected a strict RFC3339 instant";
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  if (year < 1 || year > 9999) return "year must be between 0001 and 9999";
+  if (
+    month < 1 ||
+    month > 12 ||
+    day < 1 ||
+    day > new Date(Date.UTC(year, month, 0)).getUTCDate()
+  ) return "expected a valid calendar instant";
+  return Number.isNaN(Date.parse(text)) ? "expected a valid calendar instant" : undefined;
+}));
+
+const HistoryWire = Schema.Struct({
+  checkedAt: Rfc3339Instant,
+  durationMillis: DurationMillis,
+});
+
+export const decodeHistoryCheck = (input: unknown) =>
+  Schema.decodeUnknownEffect(HistoryWire)(input).pipe(
+    Effect.flatMap(({ durationMillis }) => decodeCanonicalStoredCheck(input).pipe(
+      Effect.map((check) => new CheckResult({
+        ...check,
+        duration: Duration.nanos(BigInt(durationMillis * 1_000_000)),
+      })),
+    )),
+  );
