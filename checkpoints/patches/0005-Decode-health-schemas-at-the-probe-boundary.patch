 import type { ProbeClientShape } from "../services/ProbeClient.js";
 const Ajv = AjvModule as unknown as new () => {
@@ -25,14 +27,25 @@ const Ajv = AjvModule as unknown as new () => {
-  validate(schema: object, value: unknown): boolean;
+  compile(schema: object | boolean): ((value: unknown) => boolean) & { readonly $async?: boolean };
 };
 const ajv = new Ajv();
+const bodyMatches = (schema: object | boolean, body: unknown) => Effect.try({
+  try: () => {
+    const validate = ajv.compile(schema);
+    if (validate.$async === true) throw new Error("async schemas are not supported");
+    return validate(body) === true;
+  },
+  catch: (cause) => new HealthSchemaParseError({ reason: String(cause) }),
+});
 const sleep = (ms: number, _s?: AbortSignal) =>
   new Promise<void>((resolve) => setTimeout(resolve, ms));
-export const decodeHealthSchema = (encoded: string): object => {
-  const schema: unknown = JSON.parse(encoded);
+export const decodeHealthSchema = (encoded: string) => Effect.gen(function*() {
+  const schema = yield* Effect.try({
+    try: () => JSON.parse(encoded) as unknown,
+    catch: (cause) => new HealthSchemaParseError({ reason: String(cause) }),
+  });
-  if (schema === null || typeof schema !== "object" || Array.isArray(schema))
+  if (schema === null || (typeof schema !== "object" && typeof schema !== "boolean") || Array.isArray(schema))
-    throw new TypeError("health schema must be an object");
+    return yield* Effect.fail(new HealthSchemaParseError({ reason: "health schema must be an object or boolean" }));
   return schema;
-};
+});
 export const repeatSuccessfulProbe = async <A>(run: () => Promise<A>, repeats: number) => {
   // Execute the supplied probe.
   return [await run()];
@@ -73,8 +86,13 @@ export async function probeOnce(
   let bodyValid = true;
   if (raw) {
     if (target.healthBodySchema !== undefined) {
-      const healthSchema = decodeHealthSchema(target.healthBodySchema);
-      bodyValid = Boolean(ajv.validate(healthSchema, raw.body));
+      const decoded = await Effect.runPromise(Effect.result(decodeHealthSchema(target.healthBodySchema)));
+      if (Result.isFailure(decoded)) failure = decoded.failure;
+      else {
+        const matched = await Effect.runPromise(Effect.result(bodyMatches(decoded.success, raw.body)));
+        if (Result.isFailure(matched)) failure = matched.failure;
+        else if (!matched.success) failure = new HealthBodyMismatch();
+      }
     } else bodyValid = raw.body !== "not-json";
   }
   let classified = classifyProbe({
diff --git a/test/checkpoint-04/schema-boundary.test.ts b/test/checkpoint-04/schema-boundary.test.ts
new file mode 100644
index 0000000..d49c01b
--- /dev/null
+++ b/test/checkpoint-04/schema-boundary.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { Effect, Exit } from "effect";
+import { HealthBodyMismatch, HealthSchemaParseError } from "../../src/domain/errors.js";
+import { Target } from "../../src/domain/schema.js";
+import { decodeHealthSchema, probeOnce } from "../../src/probe/ProbeProgram.js";
+import { FakeProbeClient } from "../../src/services/ProbeClient.js";
+
+const target = (schema: string) => new Target({ id: "target_schema", name: "Schema", url: "https://example.test", method: "GET", expectedStatus: [200], interval: 10, timeout: 50, slowThreshold: 20, healthBodySchema: schema, enabled: true });
+
+describe("health schema boundary", () => {
+  it("reports malformed schema input as a typed failure", async () => {
+    const exit = await Effect.runPromise(Effect.exit(decodeHealthSchema("not json")));
+    expect(Exit.isFailure(exit)).toBe(true);
+    if (Exit.isFailure(exit)) expect(exit.cause.reasons.some((reason) => reason._tag === "Fail" && reason.error instanceof HealthSchemaParseError)).toBe(true);
+  });
+  it("keeps a valid schema mismatch distinct", async () => {
+    const result = await probeOnce(target(JSON.stringify({ type: "object", required: ["ok"], properties: { ok: { const: true } } })), new FakeProbeClient({ target_schema: { status: 200, body: { ok: false }, bytes: 12 } }));
+    expect(result.classification._tag).toBe("InvalidResponse");
+    expect(result.failure?.reason).toBe(new HealthBodyMismatch()._tag);
+  });
+});
