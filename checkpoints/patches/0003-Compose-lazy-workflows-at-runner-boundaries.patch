index b81732f..0796aff 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -1,10 +1,13 @@
 import { runCli } from "./cli/cli.js";
+import { Effect } from "effect";
 export const repositoryChoice = (env: Record<string, string | undefined>) =>
   env.BEACONWATCH_REPOSITORY === "sqlite"
     ? ("sqlite" as const)
     : ("memory" as const);
 export const main = (argv = process.argv.slice(2)) => runCli(argv);
+export const startupEffect = (load: () => Promise<void>) =>
+  Effect.tryPromise({ try: load, catch: (cause) => cause });
 export const eagerStartup = (load: () => Promise<void>) => {
-  const loading = load();
-  return () => loading;
+  const program = startupEffect(load);
+  return () => Effect.runPromise(program);
 };
diff --git a/src/services/HttpProbeClient.ts b/src/services/HttpProbeClient.ts
index ba3c570..6c42447 100644
--- a/src/services/HttpProbeClient.ts
+++ b/src/services/HttpProbeClient.ts
@@ -5,9 +5,32 @@ import {
   UnexpectedStatus,
 } from "../domain/errors.js";
 import type { ProbeClientShape, RawProbeResponse } from "./ProbeClient.js";
-import type { ProbeTarget } from "./ProbeClient.js";
+import type { ProbeFailure, ProbeTarget } from "./ProbeClient.js";
+import { Effect } from "effect";
 export class HttpProbeClient implements ProbeClientShape {
+  readonly preferProbeEffect = true;
   constructor(private fetcher: typeof fetch = fetch) {}
+  probeEffect(target: ProbeTarget) {
+    return Effect.callback<RawProbeResponse, ProbeFailure>((resume, signal) => {
+      const isFailure = (cause: unknown): cause is ProbeFailure =>
+        cause instanceof DnsError || cause instanceof InvalidBody || cause instanceof TimeoutError || cause instanceof UnexpectedStatus;
+      const finish = (cause: unknown) => resume(isFailure(cause) ? Effect.fail(cause) : Effect.die(cause));
+      let running: Promise<RawProbeResponse>;
+      try {
+        running = this.probe === HttpProbeClient.prototype.probe
+          ? this.request(target, signal, false)
+          : this.probe(target, signal);
+      } catch (cause) {
+        finish(cause);
+        return;
+      }
+      running.then(
+        (response) => resume(Effect.succeed(response)),
+        finish,
+      );
+      return Effect.promise(() => running.then(() => undefined, () => undefined));
+    });
+  }
   async probe(
     target: ProbeTarget,
     signal?: AbortSignal,
@@ -14,12 +37,21 @@ export class HttpProbeClient implements ProbeClientShape {
   ): Promise<RawProbeResponse> {
+    return this.request(target, signal, true);
+  }
+
+  private async request(
+    target: ProbeTarget,
+    signal: AbortSignal | undefined,
+    withTimeout: boolean,
+  ): Promise<RawProbeResponse> {
+    if (signal?.aborted) throw signal.reason;
     let url: URL;
     try {
       url = new URL(target.url);
     } catch (e) {
       throw new InvalidBody({ reason: `invalid URL: ${String(e)}` });
     }
     const own = new AbortController();
-    setTimeout(() => own.abort(), target.timeout);
+    const timer = withTimeout ? setTimeout(() => own.abort(), target.timeout) : undefined;
     const abort = () => own.abort(signal?.reason);
     signal?.addEventListener("abort", abort, { once: true });
     try {
@@ -26,5 +50,6 @@ export class HttpProbeClient implements ProbeClientShape {
       const response = await this.fetcher(url, {
         method: target.method,
+        headers: { Accept: "application/json" },
         signal: own.signal,
       });
       if (!target.expectedStatus.includes(response.status))
@@ -50,9 +83,13 @@ export class HttpProbeClient implements ProbeClientShape {
       return { status: response.status, body, bytes: bytes.byteLength };
     } catch (e) {
       if (e instanceof InvalidBody || e instanceof UnexpectedStatus) throw e;
+      if (signal?.aborted) throw signal.reason;
       if (own.signal.aborted)
         throw new TimeoutError({ timeout: String(target.timeout), cause: e });
       throw new DnsError({ host: url.host, cause: e });
+    } finally {
+      if (timer) clearTimeout(timer);
+      signal?.removeEventListener("abort", abort);
     }
