diff --git a/src/services/IncidentService.ts b/src/services/IncidentService.ts
index c140917..9c58e21 100644
--- a/src/services/IncidentService.ts
+++ b/src/services/IncidentService.ts
@@ -3,14 +3,21 @@ import type {
   CheckRepositoryShape,
   IncidentTransition,
 } from "../repo/CheckRepository.js";
+import { Effect } from "effect";
 export class IncidentService {
   constructor(private repo: CheckRepositoryShape) {}
   applyCheck(check: CheckResult): Promise<IncidentTransition> {
     return this.repo.applyCheck(check);
   }
-  acknowledge(check: CheckResult) {
-    void this.repo.applyCheck(check);
-    return "acknowledged";
+  acknowledgeEffect(check: CheckResult) {
+    const repo = this.repo;
+    return Effect.gen(function*() {
+      yield* Effect.tryPromise({ try: () => repo.applyCheck(check), catch: (cause) => cause });
+      return "acknowledged" as const;
+    });
+  }
+  acknowledge(check: CheckResult): Promise<"acknowledged"> {
+    return Effect.runPromise(this.acknowledgeEffect(check));
   }
 }
 export const Live = (repo: CheckRepositoryShape) => new IncidentService(repo);
